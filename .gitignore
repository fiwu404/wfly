# Build output
**/[Bb]in/
**/[Oo]bj/

# Local .NET CLI and NuGet caches used by this workspace
/.dotnet-cli/
/.nuget/

# Visual Studio, Rider, VS Code and user-specific files
/.vs/
/.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.pidb
