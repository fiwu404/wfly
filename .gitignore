# Test, coverage and diagnostic output
TestResults/
**/TestResults/
coverage/
*.coverage
*.coveragexml
*.trx
*.log

# Package and publish artifacts
*.nupkg
*.snupkg
artifacts/

# Published portable bundle. Keep only the downloadable executable and notes;
# runtime data created beside a locally launched release remains private.
/release/*
!/release/WFly.exe
!/release/README.md
!/release/SHA256SUMS.txt

# Local configuration and credentials
.env
.env.*
*.local.json
appsettings.Development.json
*.pfx
*.p12
*.pem
*.key

# Windows Explorer metadata
[Dd]esktop.ini
Thumbs.db
